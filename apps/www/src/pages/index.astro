---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code, LinkButton } from '@astrojs/starlight/components';
import BenchChart from '../components/BenchChart.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const hero = `import { NestFactory } from '@nestjs/core';
import { BunAdapter, type NestBunApplication } from '@nestbun/platform';

const app = await NestFactory.create<NestBunApplication>(
  AppModule,
  new BunAdapter(),
);
await app.listen(3000);`;

const features = [
  ['Routing', 'Params, wildcards, @All, HEAD → GET fallback, first-match order like Express.'],
  ['Every decorator', '@Body, @Query, @Param, @Headers, @Ip, @Req, @Res, @Next, @Redirect, @Header, @HttpCode.'],
  ['Body parsing', 'JSON and urlencoded by default, text and raw on request, rawBody, size limits with 413.'],
  ['Middleware', 'MiddlewareConsumer, forRoutes, exclude, method scoping, app.use(), next(err).'],
  ['Prefix & versioning', 'Global prefix with exclude; URI, header, media-type and custom versioning.'],
  ['Streaming', 'Server-Sent Events with disconnect detection, StreamableFile, manual res.write().'],
  ['Static & views', 'Zero-copy Bun.file() with ETag and 304; ejs, hbs, pug or a custom render().'],
  ['Ecosystem', '@nestjs/swagger and @nestjs/testing work untouched. CORS via the cors package.'],
  ['Lifecycle', 'HTTPS, graceful shutdown with drain timeout, forceCloseConnections, unix sockets.'],
];
---

<StarlightPage
  frontmatter={{
    title: 'NestJS on Bun, natively',
    template: 'splash',
    hero: {
      tagline:
        'An HTTP adapter that runs your Nest app straight on Bun.serve(). Swap one line, keep every controller, pipe, guard and filter, and drop the build step.',
      actions: [
        { text: 'Get started', link: `${base}/docs/getting-started/`, icon: 'right-arrow', variant: 'primary' },
        { text: 'View on GitHub', link: 'https://github.com/mguay22/nestbun', icon: 'github', variant: 'minimal' },
      ],
    },
  }}
>
  <section class="hero-code">
    <Code code={hero} lang="ts" title="src/main.ts" />
    <p class="run">
      <code>bun add @nestbun/platform</code> · <code>bun src/main.ts</code> · no <code>nest build</code>, no <code>dist/</code>
    </p>
  </section>

  <section>
    <h2>Why not just run Express on Bun?</h2>
    <p class="lede">
      You can, and it works. But every request pays for a Node compatibility layer. Going straight to Bun's native
      server removes it, and brings Web-standard primitives with it.
    </p>
    <div class="cards">
      <div class="card">
        <h3>Faster than Express and Fastify</h3>
        <p>Same app, same runtime, same machine: more requests per second on both JSON reads and JSON writes.</p>
      </div>
      <div class="card">
        <h3>Web standards underneath</h3>
        <p>
          Requests are Web <code>Request</code>s, responses become Web <code>Response</code>s, files stream with
          zero-copy <code>Bun.file()</code>. Express-shaped <code>req</code>/<code>res</code> keep the ecosystem working.
        </p>
      </div>
      <div class="card">
        <h3>Tests without sockets</h3>
        <p>
          <code>adapter.fetch(new Request(...))</code> runs a request through the full Nest pipeline in-process. No
          supertest, no port, no flakiness.
        </p>
      </div>
    </div>
  </section>

  <section>
    <h2>Benchmarks</h2>
    <BenchChart />
    <p class="more"><a href={`${base}/docs/benchmarks/`}>Methodology and how to reproduce →</a></p>
  </section>

  <section>
    <h2>What works today</h2>
    <p class="lede">Every row is covered by an integration test that boots a real Nest application on the adapter.</p>
    <div class="features">
      {
        features.map(([title, body]) => (
          <div class="feature">
            <h3>{title}</h3>
            <p>{body}</p>
          </div>
        ))
      }
    </div>
    <p class="more"><a href={`${base}/docs/compatibility/`}>Full compatibility table →</a></p>
  </section>

  <section class="starter">
    <h2>Start from a Bun-native template</h2>
    <p class="lede">
      <code>create-nest-bun</code> is <code>nest new</code> for the Bun runtime: ESM, Zod validation,
      <code>bun test</code>, no build step. Add <code>--adapter bun</code> to scaffold on this adapter.
    </p>
    <Code code={'bun create nest-bun my-api --adapter bun\ncd my-api && bun dev'} lang="sh" />
    <div class="actions">
      <LinkButton href={`${base}/docs/getting-started/`} icon="right-arrow">Read the docs</LinkButton>
      <LinkButton href="https://github.com/mguay22/nest-bun" variant="secondary" icon="github">Template repo</LinkButton>
    </div>
  </section>
</StarlightPage>

<style>
  section {
    margin: 3.5rem auto 0;
    max-width: 62rem;
  }
  .hero-code {
    margin-top: 1rem;
  }
  .run {
    text-align: center;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin-top: 0.75rem;
  }
  h2 {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }
  .lede {
    color: var(--sl-color-gray-2);
    max-width: 44rem;
    margin: 0 0 1.5rem;
  }
  .cards,
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  @media (max-width: 760px) {
    .cards,
    .features {
      grid-template-columns: 1fr;
    }
  }
  /* Starlight's markdown styles add margin-top to non-first children; grids must stay aligned. */
  .cards > *,
  .features > *,
  .card > *,
  .feature > * {
    margin-top: 0 !important;
  }
  .card h3,
  .feature h3 {
    margin-bottom: 0.4rem !important;
  }
  .card,
  .feature {
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 1.1rem 1.25rem;
  }
  .card h3,
  .feature h3 {
    font-size: 1rem;
    margin: 0 0 0.4rem;
  }
  .card p,
  .feature p {
    margin: 0;
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .more {
    margin-top: 1rem;
  }
  .starter {
    margin-bottom: 4rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
