---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Card, CardGrid, Code, LinkButton } from '@astrojs/starlight/components';
import BenchChart from '../components/BenchChart.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = 'https://mguay22.github.io';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'nestbun',
  description: 'A NestJS adapter for Bun that runs Nest applications natively on Bun.serve().',
  url: `${site}${base}/`,
  codeRepository: 'https://github.com/mguay22/nestbun',
  programmingLanguage: 'TypeScript',
  runtimePlatform: 'Bun',
  license: 'https://opensource.org/licenses/MIT',
  author: { '@type': 'Person', name: 'Michael Guay', url: 'https://github.com/mguay22' },
  keywords: 'NestJS, Bun, adapter, Bun.serve, HTTP',
});

const hero = `import { NestFactory } from '@nestjs/core';
import { BunAdapter, type NestBunApplication } from '@nestbun/platform';

const app = await NestFactory.create<NestBunApplication>(
  AppModule,
  new BunAdapter(),
);
await app.listen(3000);`;
---

<StarlightPage
  frontmatter={{
    title: 'Run NestJS on Bun, natively',
    description:
      'nestbun is a NestJS adapter for Bun. Run your Nest app on Bun.serve() with a one-line change: faster than Express and Fastify, no build step, full Nest compatibility.',
    template: 'splash',
    head: [{ tag: 'script', attrs: { type: 'application/ld+json' }, content: jsonLd }],
    hero: {
      title: 'NestJS on Bun, natively',
      tagline:
        'A NestJS Bun adapter that runs your app straight on Bun.serve(). Swap one line, keep every controller, pipe, guard and filter, and drop the build step.',
      actions: [
        { text: 'Get started', link: `${base}/docs/getting-started/`, icon: 'right-arrow', variant: 'primary' },
        { text: 'View on GitHub', link: 'https://github.com/mguay22/nestbun', icon: 'github', variant: 'minimal' },
      ],
    },
  }}
>
  <section class="hero-code">
    <h3>Start a new project</h3>
    <Code code={'bun create @nestbun my-api --adapter bun\ncd my-api && bun dev'} lang="sh" />

    <h3>Or add it to an existing project</h3>
    <Code code={'bun add @nestbun/platform\nbun remove @nestjs/platform-express'} lang="sh" />
    <p class="run">Then one line in <code>main.ts</code> is the whole migration:</p>
    <Code code={hero} lang="ts" title="src/main.ts" />
  </section>

  <section>
    <h2>Why not just run Express on Bun?</h2>
    <p class="lede">
      You can, and it works. But every request pays for a Node compatibility layer. Going straight to Bun's native
      server removes it, and brings Web-standard primitives with it.
    </p>
    <CardGrid>
      <Card title="Faster than Express and Fastify" icon="rocket">
        Same app, same runtime, same machine: more requests per second on both JSON reads and JSON writes.
      </Card>
      <Card title="One-line migration" icon="approve-check">
        Pass <code>new BunAdapter()</code> to <code>NestFactory.create()</code>. Controllers, pipes, guards, filters,
        middleware and <code>@Res()</code> handlers stay as they are.
      </Card>
      <Card title="Web standards underneath" icon="puzzle">
        Requests are Web <code>Request</code>s, responses become Web <code>Response</code>s, files stream with
        zero-copy <code>Bun.file()</code>. Express-shaped <code>req</code>/<code>res</code> keep the ecosystem working.
      </Card>
      <Card title="Tests without sockets" icon="laptop">
        <code>adapter.fetch(new Request(...))</code> runs a request through the full Nest pipeline in-process. No
        supertest, no port, no flakiness.
      </Card>
    </CardGrid>
  </section>

  <section>
    <h2>Benchmarks</h2>
    <BenchChart />
    <p class="more"><a href={`${base}/docs/benchmarks/`}>Methodology and how to reproduce →</a></p>
  </section>

  <section>
    <h2>What works today</h2>
    <p class="lede">Every item is covered by an integration test that boots a real Nest application on the adapter.</p>
    <CardGrid>
      <Card title="Routing and decorators" icon="random">
        Params, wildcards, <code>@All</code>, HEAD → GET fallback, first-match order like Express. <code>@Body</code>,
        <code>@Query</code>, <code>@Param</code>, <code>@Headers</code>, <code>@Ip</code>, <code>@Req</code>,
        <code>@Res</code>, <code>@Next</code>, <code>@Redirect</code>, <code>@Header</code>, <code>@HttpCode</code>.
      </Card>
      <Card title="Body parsing" icon="document">
        JSON and urlencoded by default, text and raw on request, <code>rawBody</code> for webhooks, size limits with
        413, Express-identical 400 shapes for bad JSON.
      </Card>
      <Card title="Middleware, prefix, versioning" icon="setting">
        <code>MiddlewareConsumer</code> with <code>forRoutes</code>, <code>exclude</code> and method scoping,
        <code>app.use()</code>, <code>next(err)</code>, global prefix, URI / header / media-type versioning, CORS.
      </Card>
      <Card title="Streaming" icon="forward-slash">
        Server-Sent Events with disconnect detection, <code>StreamableFile</code>, manual <code>res.write()</code>,
        zero-copy file sends.
      </Card>
      <Card title="Static files and views" icon="open-book">
        <code>useStaticAssets</code> with ETag, Last-Modified and 304; <code>ejs</code>, <code>hbs</code>,
        <code>pug</code> or any <code>render()</code> function.
      </Card>
      <Card title="Ecosystem and lifecycle" icon="star">
        <code>@nestjs/swagger</code> and <code>@nestjs/testing</code> untouched. HTTPS, graceful shutdown with a drain
        timeout, <code>forceCloseConnections</code>, unix sockets.
      </Card>
    </CardGrid>
    <p class="more"><a href={`${base}/docs/compatibility/`}>Full compatibility table →</a></p>
  </section>

  <section class="starter">
    <h2>Start from a Bun-native template</h2>
    <p class="lede">
      <code>@nestbun/create</code> is <code>nest new</code> for the Bun runtime: ESM, Zod validation,
      <code>bun test</code>, no build step. Add <code>--adapter bun</code> to scaffold on this adapter.
    </p>
    <Code code={'bun create @nestbun my-api --adapter bun\ncd my-api && bun dev'} lang="sh" />
    <div class="actions">
      <LinkButton href={`${base}/docs/getting-started/`} icon="right-arrow">Read the docs</LinkButton>
      <LinkButton href="https://github.com/mguay22/nestbun/tree/main/packages/create" variant="secondary" icon="github">
        Generator source
      </LinkButton>
    </div>
  </section>
</StarlightPage>

<style>
  section {
    margin: 3.5rem auto 0;
    max-width: 62rem;
  }
  .hero-code {
    margin-top: 1rem;
  }
  .hero-code h3 {
    font-size: 1.1rem;
    margin: 1.75rem 0 0.5rem;
  }
  .hero-code h3:first-child {
    margin-top: 0;
  }
  .run {
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    margin: 1rem 0 0.5rem;
  }
  h2 {
    font-size: 1.75rem;
    margin: 0 0 0.5rem;
  }
  .lede {
    color: var(--sl-color-gray-2);
    max-width: 44rem;
    margin: 0 0 1.5rem;
  }
  .more {
    margin-top: 1rem;
  }
  .starter {
    margin-bottom: 4rem;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.25rem;
  }
</style>
