{
  "name": "@nestbun/platform",
  "version": "0.1.1",
  "description": "NestJS HTTP adapter for the Bun runtime \u2014 run Nest on Bun.serve instead of Express",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "keywords": [
    "nestjs",
    "bun",
    "adapter",
    "platform",
    "http",
    "bun.serve"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mguay22/nestbun.git",
    "directory": "packages/platform"
  },
  "homepage": "https://mguay22.github.io/nestbun/",
  "bugs": "https://github.com/mguay22/nestbun/issues",
  "engines": {
    "bun": ">=1.4.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "path-to-regexp": "^8.4.2"
  },
  "devDependencies": {
    "@nestjs/common": "12.1.0",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/passport": "12.0.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/testing": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "^2.8.19",
    "@types/passport-jwt": "4.0.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  }
}
