{
  "name": "nestbun-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*",
    "bench"
  ],
  "scripts": {
    "test": "bun test packages/platform packages/create/test",
    "typecheck": "bun run --filter '@nestbun/platform' --filter '@nestbun/create' --filter '@nestbun/example-basic' typecheck",
    "build": "bun run --filter '@nestbun/platform' --filter '@nestbun/create' build"
  },
  "devDependencies": {
    "bun-types": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
